# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit passwords to git)
.env
*.env.local
.env.*.local

# Private Keys & Sensitive Keystores (CRITICAL: Never commit private keys)
*.key
*.pem.key
*.pfx
*.p12
*.jks

# Custom Certificates folder (Ignore certificates, keep documentation & placeholders)
cert/*
!cert/README.md
!cert/.gitkeep

# Download folder (Ignore downloaded packages/archives, keep manifest & docs)
dl/*
!dl/README.md
!dl/.gitkeep
!dl/downloads.txt
!dl/DOWNLOADS.md

# Session & temporary test files
cookies.txt
*.log
*.tmp
*.bak

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Playwright & Node.js test artifacts
e2e-test/node_modules/
e2e-test/playwright-report/
e2e-test/test-results/
e2e-test/.env
